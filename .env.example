# Copy this file to .env and fill in your own values

# Google Sheets
# The long ID in your sheet's URL: docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit
SPREADSHEET_ID=
# The tab name, e.g. Internship_Applications
SHEET_NAME=
# Path to the service account JSON key
SERVICE_ACCOUNT_FILE=

# Gemini API key from https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Email (SENDER_PASSWORD must be a Gmail App Password, not your normal password)
SENDER_EMAIL=
SENDER_PASSWORD=
RECIPIENT_EMAIL=
